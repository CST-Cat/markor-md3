<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="AppTheme.Unified.StartupFlash" parent="AppTheme.Unified">
        <item name="android:windowBackground">@color/dark__background</item>
    </style>

    <!-- Material Design 3 main theme.
         Color roles come from the m3_* tokens in values/colors.xml and
         values-night/colors.xml. MD3 themes have no dark action bar and
         no colorPrimaryDark; bars are tonal surfaces. -->
    <style name="AppTheme.Unified" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:actionButtonStyle">@style/LessSpaceActionButtonStyle</item>
        <item name="preferenceTheme">@style/AppTheme.PreferenceTheme</item>
        <item name="dialogTheme">@style/Theme.AppCompat.DayNight.Dialog.Rounded</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.DayNight.Dialog.Rounded</item>

        <!-- MD3 color roles -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>
        <!-- Legacy aliases kept mapped for the code that still reads them -->
        <item name="colorAccent">@color/m3_tertiary</item>
        <item name="colorPrimaryDark">@color/m3_surface_container</item>
        <item name="android:actionModeBackground">@color/m3_surface_container_high</item>
        <item name="actionModeBackground">@color/m3_surface_container_high</item>
        <item name="android:windowBackground">@color/m3_background</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>

        <!-- MD3 shape scale for components -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.LargeComponent</item>

        <!-- Android V21 options; ignore IDE warnings -->
        <item name="android:windowContentTransitions" tools:targetApi="lollipop">true</item>
        <item name="android:windowAllowEnterTransitionOverlap" tools:targetApi="lollipop">true</item>
        <item name="android:windowAllowReturnTransitionOverlap" tools:targetApi="lollipop">true</item>
        <item name="android:windowSharedElementEnterTransition" tools:targetApi="lollipop">@android:transition/move</item>
        <item name="android:windowSharedElementExitTransition" tools:targetApi="lollipop">@android:transition/move</item>
        <!-- Edge-to-edge: transparent system bars, surfaces draw behind them.
             Runtime code still tints the status bar with the tonal bar color. -->
        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@android:color/transparent</item>

        <!-- Android V28 options; ignore IDE warnings -->
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_corner_radius</item>
    </style>

    <style name="AppTheme.PreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/AppTheme.PreferenceTheme.CategoryStyle</item>
    </style>

    <style name="AppTheme.PreferenceTheme.CategoryStyle" parent="Preference.Category">
        <item name="android:layout">@layout/opoc_pref_category_text</item>
    </style>

    <!-- Toolbar overlay: name kept (referenced by layouts), content is now
         MD3 - toolbar sits on a surface, so text/icons use on-surface roles
         in both light and dark mode instead of forced white-on-navy. -->
    <style name="LightTextToolbarOverlay" parent="ThemeOverlay.Material3">
        <item name="android:actionModeBackground">@color/m3_surface_container_high</item>
        <item name="actionModeBackground">@color/m3_surface_container_high</item>

        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="AppTheme.Light.AppBarOverlay" parent="ThemeOverlay.Material3" />

    <!-- reduced spacing (parent kept from AppCompat: MaterialComponents ships
         no ActionButton widget style; the tweaks are size-only) -->
    <style name="LessSpaceActionButtonStyle" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">1dip</item>
        <item name="android:paddingLeft">8dip</item>
        <item name="android:paddingRight">8dip</item>
        <item name="android:paddingStart">8dip</item>
        <item name="android:paddingEnd">8dip</item>
    </style>

    <!-- Dialog theme: style name kept because 20+ call sites reference
         R.style.Theme_AppCompat_DayNight_Dialog_Rounded directly; the parent
         and content are now Material 3 (surfaceContainerHigh, 28dp corner). -->
    <style name="Theme.AppCompat.DayNight.Dialog.Rounded" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorBackground">@color/m3_surface_container_high</item>
        <item name="android:colorBackgroundFloating" tools:targetApi="23">@color/m3_surface_container_high</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorAccent">@color/m3_primary</item>
    </style>

    <!-- Claude color scheme overlay (optional, Settings > Appearance >
         Color scheme). Applied at runtime on top of AppTheme.Unified by
         MarkorBaseActivity when selected; remaps the MD3 color roles to
         the claude_* palette from DESIGN.md. Anything not listed here
         (shapes, typography, non-color attrs) stays stock MD3. -->
    <style name="ThemeOverlay.Markor.Claude" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/claude_primary</item>
        <item name="colorOnPrimary">@color/claude_on_primary</item>
        <item name="colorPrimaryContainer">@color/claude_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/claude_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/claude_inverse_primary</item>
        <item name="colorSecondary">@color/claude_secondary</item>
        <item name="colorOnSecondary">@color/claude_on_secondary</item>
        <item name="colorSecondaryContainer">@color/claude_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/claude_on_secondary_container</item>
        <item name="colorTertiary">@color/claude_tertiary</item>
        <item name="colorOnTertiary">@color/claude_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/claude_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/claude_on_tertiary_container</item>
        <item name="colorError">@color/claude_error</item>
        <item name="colorOnError">@color/claude_on_error</item>
        <item name="colorErrorContainer">@color/claude_error_container</item>
        <item name="colorOnErrorContainer">@color/claude_on_error_container</item>
        <item name="colorOnBackground">@color/claude_on_background</item>
        <item name="colorSurface">@color/claude_surface</item>
        <item name="colorOnSurface">@color/claude_on_surface</item>
        <item name="colorSurfaceVariant">@color/claude_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/claude_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/claude_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/claude_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/claude_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/claude_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/claude_surface_container_highest</item>
        <item name="colorOutline">@color/claude_outline</item>
        <item name="colorOutlineVariant">@color/claude_outline_variant</item>
        <item name="colorSurfaceInverse">@color/claude_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/claude_on_surface_inverse</item>
        <item name="colorAccent">@color/claude_primary</item>
        <item name="colorControlActivated">@color/claude_primary</item>
        <item name="dialogTheme">@style/Theme.Markor.Claude.Dialog.Rounded</item>
        <item name="alertDialogTheme">@style/Theme.Markor.Claude.Dialog.Rounded</item>
    </style>

    <!-- Claude variant of the rounded dialog theme: same shape/metrics as
         the stock dialog style, Claude surface instead of the MD3 one
         (the stock style points at a fixed @color/m3_* background). -->
    <style name="Theme.Markor.Claude.Dialog.Rounded" parent="Theme.AppCompat.DayNight.Dialog.Rounded">
        <item name="android:colorBackground">@color/claude_surface_container_high</item>
        <item name="android:colorBackgroundFloating" tools:targetApi="23">@color/claude_surface_container_high</item>
    </style>
</resources>
